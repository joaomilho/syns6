{
  "name": "syns",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:tauri": "concurrently -n web,tauri -c blue,green \"npm run dev\" \"cd tauri && npm run tauri dev\"",
    "build": "prisma generate && next build",
    "build:prod": "npm run build && npm run prepare:standalone",
    "build:tauri": "cd tauri && npm run tauri build",
    "build:app": "npm run download:node && npm run build:prod && npm run build:tauri",
    "download:node": "bash scripts/download-node.sh",
    "prepare:standalone": "bash scripts/prepare-standalone.sh",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "generate-songs": "tsx scripts/generateSongsList.ts",
    "fetch-lyrics": "tsx scripts/fetchLyrics.ts",
    "capture-screenshots": "tsx scripts/captureScreenshots.ts",
    "screenshots": "tsx scripts/captureScreenshots.ts",
    "test:parser": "tsx src/lib/songParser.test.ts",
    "postinstall": "node scripts/conditional-prisma.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@react-three/postprocessing": "^3.0.4",
    "@tauri-apps/api": "^2.9.1",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "expr-eval": "^2.0.2",
    "fuse.js": "^7.1.0",
    "localforage": "^1.10.0",
    "lucide-react": "^0.555.0",
    "next": "^16.1.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-qr-code": "^2.0.18",
    "react-social-media-embed": "^2.5.18",
    "resend": "^6.5.2",
    "stripe": "^17.4.0",
    "three": "^0.181.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.0.3",
    "next-sitemap": "^4.2.3",
    "playwright": "^1.49.0",
    "prisma": "^5.22.0",
    "tsx": "^4.7.0",
    "typescript": "^5"
  }
}
