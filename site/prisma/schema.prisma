// This is a dummy Prisma schema to prevent Vercel from trying to validate the parent directory's schema
// This site does not use a database

datasource db {
  provider = "sqlite"
  url      = "file:./dummy.db"
}

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

// Empty model to satisfy Prisma schema requirements
model Dummy {
  id String @id @default("dummy")
}

