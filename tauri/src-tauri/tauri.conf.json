{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syns6",
  "version": "0.2.0",
  "identifier": "com.syns6",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3000/player",
    "beforeBuildCommand": "cd .. && npm run build:prod",
    "frontendDist": "http://127.0.0.1:3000/player"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "",
        "width": 1200,
        "height": 800,
        "fullscreen": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*",
      "resources/server/**/*"
    ],
    "externalBin": [
      "resources/node-sidecar"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    }
  }
}
