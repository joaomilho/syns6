{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "syns6-app",
  "version": "0.1.0",
  "identifier": "com.syns6",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://127.0.0.1:3000/player",
    "beforeBuildCommand": "",
    "frontendDist": "https://syns6.com/player"
  },
  "app": {
    "windows": [
      {
        "title": "Syns6",
        "width": 1200,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./entitlements.plist",
      "infoPlist": "./Info.plist"
    }
  }
}
