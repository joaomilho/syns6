// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
// Required by @next-auth/prisma-adapter
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  // Referral system
  referralCode  String?   @unique
  referredBy    String?   // User ID who referred them
  referralCount Int       @default(0)
  
  accounts      Account[]
  sessions      Session[]
  preferences   UserPreferences?
  playHistory   PlayHistory[]
  subscription  Subscription?
  
  // Stripe customer ID
  stripeCustomerId String? @unique
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User preferences for visualizations and Hue settings
model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Visualization preferences
  preferredVisualization String?  @default("spectrum")
  visualizationIntensity Float?   @default(1.0)
  
  // Lyrics preferences
  lyricsFont            String?  @default("Poppins")
  lyricsColor           String?  @default("#ff0")
  
  // Hue light preferences
  hueMaxIntensity       Float?   @default(1.0)
  hueBridgeIp           String?
  hueUsername           String?
  enableHueLights       Boolean  @default(false)
  
  // Audio preferences
  audioSensitivity      Float?   @default(1.0)
  bassBoost             Float?   @default(1.0)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("user_preferences")
}

// Cached lyrics to avoid repeated API calls
model Lyrics {
  id           String   @id @default(cuid())
  spotifyId    String   @unique // Spotify track ID
  title        String
  artist       String
  album        String?
  duration     Int?     // Track duration in ms
  
  instrumental Boolean @default(false)
  // Lyrics data
  lyrics       String?
  
  source       String?  // Which API provided the lyrics (LRCLIB, NetEase, etc)
  fetchedAt    DateTime @default(now())
  
  // Analytics
  accessCount  Int      @default(0)
  lastAccessed DateTime @default(now())
  
  @@index([spotifyId])
  @@index([artist])
  @@index([title])
  @@map("lyrics")
}

// Track songs where lyrics weren't found to avoid repeated lookups
model LyricsNotFound {
  id          String   @id @default(cuid())
  spotifyId   String?  @unique
  title       String
  artist      String
  attemptedAt DateTime @default(now())
  
  @@index([title, artist])
  @@map("lyrics_not_found")
}

// Cached YouTube videos to avoid repeated API calls
model YouTubeVideo {
  id                String   @id @default(cuid())
  spotifyId         String?  @unique
  title             String
  artist            String
  youtubeId         String   // Comma-separated list of YouTube video IDs
  workingYoutubeId  String?  // Last known working video ID (crowdsourced from frontend)
  verifiedAt        DateTime? // When the working video ID was last verified
  source            String   @default("api") // "api", "manual", or "default"
  fetchedAt         DateTime @default(now())
  
  @@index([title, artist])
  @@map("youtube_videos")
}

// Play history for analytics and pre-loading
model PlayHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  trackId         String
  trackName       String
  artistName      String
  albumName       String?
  
  playedAt        DateTime @default(now())
  duration        Int?     // Track duration in ms
  playedDuration  Int?     // How long user actually played it
  
  visualizationType String?
  
  @@index([userId, playedAt])
  @@index([trackId])
  @@map("play_history")
}

// Email subscribers from landing page
model EmailSubscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  subscribedAt DateTime @default(now())
  
  @@index([email])
  @@map("email_subscribers")
}

// Stripe Subscriptions
model Subscription {
  id                   String    @id @default(cuid())
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Stripe subscription details
  stripeSubscriptionId String    @unique
  stripePriceId        String
  stripeProductId      String?
  
  // Subscription status
  status               String    // active, canceled, past_due, unpaid, trialing, etc.
  
  // Billing period
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  
  // Trial period
  trialStart           DateTime?
  trialEnd             DateTime?
  
  // Timestamps
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  
  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

// Stripe webhook events log for debugging
model StripeEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique // Stripe event ID
  type        String   // event type (e.g., customer.subscription.updated)
  data        String   // JSON data
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  
  @@index([type])
  @@index([processed])
  @@map("stripe_events")
}

// Shared sessions for live syncing
model SharedSession {
  id              String   @id @default(cuid())
  code            String   @unique // 6-digit code for easy sharing
  hostUserId      String?  // Optional - for authenticated users
  
  // Current playback state
  trackId         String?
  trackName       String?
  artistName      String?
  albumArt        String?
  duration        Int?     // in ms
  progress        Int?     // in ms
  isPlaying       Boolean  @default(false)
  
  // Next songs in queue (stored as JSON)
  queue           String?  // JSON array of queue items
  
  // Lyrics for current song (stored as JSON)
  lyrics          String?  // JSON array of lyric lines
  
  // Visualization settings
  visualizationType String?
  visualizationMode String?
  
  // Session metadata
  connectedClients Int     @default(0)
  lastUpdate       DateTime @default(now())
  lastActivity     DateTime @default(now()) // Last time clients were connected (for TTL)
  createdAt        DateTime @default(now())
  expiresAt        DateTime // Auto-expire after 24 hours
  
  @@index([code])
  @@index([expiresAt])
  @@map("shared_sessions")
}
