// This is your Prisma schema file
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth.js Models
// Required by @next-auth/prisma-adapter
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  
  accounts      Account[]
  sessions      Session[]
  preferences   UserPreferences?
  playHistory   PlayHistory[]
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// User preferences for visualizations and Hue settings
model UserPreferences {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Visualization preferences
  preferredVisualization String?  @default("spectrum")
  visualizationIntensity Float?   @default(1.0)
  
  // Hue light preferences
  hueMaxIntensity       Float?   @default(1.0)
  hueBridgeIp           String?
  hueUsername           String?
  enableHueLights       Boolean  @default(false)
  
  // Audio preferences
  audioSensitivity      Float?   @default(1.0)
  bassBoost             Float?   @default(1.0)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@map("user_preferences")
}

// Cached lyrics to avoid repeated API calls
model Lyrics {
  id           String   @id @default(cuid())
  spotifyId    String   @unique // Spotify track ID
  title        String
  artist       String
  album        String?
  duration     Int?     // Track duration in ms
  
  instrumental Boolean @default(false)
  // Lyrics data
  lyrics       String? @db.Text
  
  source       String?  // Which API provided the lyrics (LRCLIB, NetEase, etc)
  fetchedAt    DateTime @default(now())
  
  // Analytics
  accessCount  Int      @default(0)
  lastAccessed DateTime @default(now())
  
  @@index([spotifyId])
  @@index([artist])
  @@index([title])
  @@map("lyrics")
}

// Track songs where lyrics weren't found to avoid repeated lookups
model LyricsNotFound {
  id          String   @id @default(cuid())
  spotifyId   String?  @unique
  title       String
  artist      String
  attemptedAt DateTime @default(now())
  
  @@index([title, artist])
  @@map("lyrics_not_found")
}

// Cached YouTube videos to avoid repeated API calls
model YouTubeVideo {
  id          String   @id @default(cuid())
  spotifyId   String?  @unique
  title       String
  artist      String
  youtubeId   String   // YouTube video ID
  source      String   @default("api") // "api", "manual", or "default"
  fetchedAt   DateTime @default(now())
  
  @@index([title, artist])
  @@map("youtube_videos")
}

// Play history for analytics and pre-loading
model PlayHistory {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  trackId         String
  trackName       String
  artistName      String
  albumName       String?
  
  playedAt        DateTime @default(now())
  duration        Int?     // Track duration in ms
  playedDuration  Int?     // How long user actually played it
  
  visualizationType String?
  
  @@index([userId, playedAt])
  @@index([trackId])
  @@map("play_history")
}
