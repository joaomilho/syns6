"{\n  \"version\": \"1.0\",\n  \"name\": \"1000 Reactive Cubes (Cube Form)\",\n  \"objects\": [\n    {\n      \"id\": \"cubes-666\",\n      \"type\": \"group\",\n      \"count\": 1000,\n      \"geometry\": {\n        \"type\": \"box\",\n        \"width\": 0.8,\n        \"height\": 0.8,\n        \"depth\": 0.8\n      },\n      \"material\": {\n        \"type\": \"phong\",\n        \"color\": {\n          \"h\": \"index / count\",\n          \"s\": 1,\n          \"l\": 0.5\n        },\n        \"emissive\": {\n          \"h\": \"index / count\",\n          \"s\": 1,\n          \"l\": 0.2\n        },\n        \"emissiveIntensity\": 1\n      },\n      \"position\": {\n        \"x\": \"((index % 10) - 4.5) * 1.5\",\n        \"y\": \"((floor(index / 10) % 10) - 4.5) * 1.5\",\n        \"z\": \"((floor(index / 100) % 10) - 4.5) * 1.5\"\n      },\n      \"animations\": [\n        {\n          \"property\": \"scale\",\n          \"value\": \"1 + micData.energy * 1.5 + sin(time * 2 + index * 0.1) * 0.2\"\n        },\n        {\n          \"property\": \"rotation.x\",\n          \"value\": \"time * 0.3 + micData.mid * 0.5\"\n        },\n        {\n          \"property\": \"rotation.y\",\n          \"value\": \"time * 0.5 + micData.treble * 0.7\"\n        },\n        {\n          \"property\": \"rotation.z\",\n          \"value\": \"time * 0.2 + micData.bass * 0.3\"\n        },\n        {\n          \"property\": \"material.color.h\",\n          \"value\": \"(time * 0.05 + micData.bass * 0.1 + index / count) % 1\"\n        },\n        {\n          \"property\": \"material.emissiveIntensity\",\n          \"value\": \"1 + micData.drums * 2\"\n        },\n        {\n          \"property\": \"position.z\",\n          \"value\": \"((floor(index / 100) % 10) - 4.5) * 1.5 + micData.subBass * 5\"\n        }\n      ]\n    }\n  ]\n}"
