function initVisualization(scene, THREE) {
  // Store objects in scene userData for cleanup
  scene.userData.compiledObjects = scene.userData.compiledObjects || [];
  
  
  // Create group: cubes-grid (1000 objects)
  const obj_cubes_grid = [];
  const obj_cubes_grid_geometry = new THREE.BoxGeometry(0.5, 0.5, 0.5);
  
  for (let index = 0; index < 1000; index++) {
    const count = 1000;
    const obj_cubes_grid_material = new THREE.MeshPhongMaterial({ color: new THREE.Color().setHSL(0.5, 1, 0.5), emissive: new THREE.Color().setHSL(0.5, 1, 0.2), emissiveIntensity: 1 }); // Create material per object for independent colors
    const mesh = new THREE.Mesh(obj_cubes_grid_geometry, obj_cubes_grid_material);
    mesh.position.x = ((index % 10) - 5) * 1.5;
    mesh.position.y = ((Math.floor(index / 10) % 10) - 5) * 1.5;
    mesh.position.z = ((Math.floor(index / 100) % 10) - 5) * 1.5;
        mesh.material.color.setHSL((index / count), 1, 0.5);

    scene.add(mesh);
    obj_cubes_grid.push(mesh);
  }
  scene.userData.compiledObjects.push(...obj_cubes_grid);
  
  
  return scene.userData.compiledObjects;
}

